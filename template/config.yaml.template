# ============================================
# OpenCOCKeeper 新架构 — 业务配置模板
# 复制为项目根目录 config.yaml 后按需修改
# ============================================

project:
  name: "OpenCOCKeeper"
  # 调试模式：true 时日志级别自动降为 DEBUG
  debug: true
  # 模型成本追踪：true 时在日志中记录每次调用的 Token 用量与预估费用
  model_cost_tracking: false

# ------------------------------------------------------------
# 模型分级
# provider 对应 providers.ini 中的配置节名称（不区分大小写）
# input_cost / output_cost 为每百万 Token 的预估价格（人民币），用于成本估算
# ------------------------------------------------------------
model_tiers:
  fast:
    provider: "SILKFLOW"
    model_name: "deepseek-ai/DeepSeek-V3"
    temperature: 0.3
    max_tokens: 512
    input_cost: 2
    output_cost: 3
  standard:
    provider: "SILKFLOW"
    model_name: "deepseek-ai/DeepSeek-V3.2"
    temperature: 0.7
    max_tokens: 2048
    input_cost: 2
    output_cost: 3
  smart:
    provider: "SILKFLOW"
    model_name: "deepseek-ai/DeepSeek-V4-Flash"
    temperature: 0.8
    max_tokens: 4096
    input_cost: 2
    output_cost: 3

# ------------------------------------------------------------
# 存储目录（相对项目根，模块启动时自动创建）
# ------------------------------------------------------------
storage:
  data_dir: "data"
  modules_dir: "data/modules"
  raw_sources_dir: "data/raw_sources"
  backups_dir: "data/backups"
  db_path: "data/app.db"            # SQLite 主库

# ------------------------------------------------------------
# 记忆系统
# ------------------------------------------------------------
memory:
  recent_turns_window: 20
  solidify_token_threshold: 2000
  solidify_poll_interval: 60

# ------------------------------------------------------------
# 日志
# ------------------------------------------------------------
logging:
  dir: "logs"
  max_bytes: 10485760               # 10MB
  backup_count: 7
